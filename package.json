{
  "name": "gatecore",
  "version": "1.0.0",
  "description": "GateCore - Enterprise Infrastructure Management for Docker, VMs, LXC, Podman & ZFS",
  "main": "dist/backend/index.js",
  "scripts": {
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "tsc",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "node dist/backend/index.js",
    "dev:backend": "ts-node-dev --respawn --transpile-only src/backend/index.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "postinstall": "test -f prisma/schema.prisma && npx prisma generate || true",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev --name init"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-ws": "^5.0.2",
    "jsonwebtoken": "^9.0.2",
    "ldapjs": "^3.0.7",
    "multer": "^1.4.5-lts.1",
    "node-ssh": "^13.1.0",
    "prisma": "^5.10.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-ws": "^3.0.4",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/ldapjs": "^1.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.24",
    "@types/ws": "^8.5.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "ssh2@1.17.0": true,
    "cpu-features@0.0.10": true
  }
}
